{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prepspaces-backend",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./content",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PREPSPACES_DB",
      "id": "875fa82d4cc244ba838eddb8e16ff727"
    }
  ],
  "routes": [
    {
      "pattern": "api.prepspaces.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "GOOGLE_CLIENT_ID": "929583128715-vha62ek3tmooka7n67dhff3r77na4e0l.apps.googleusercontent.com"
  },
  "env": {
    "production": {
      "name": "prepspaces-backend-production",
      "routes": [
        {
          "pattern": "api.prepspaces.com",
          "custom_domain": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "PREPSPACES_DB",
          "id": "875fa82d4cc244ba838eddb8e16ff727"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "GOOGLE_CLIENT_ID": "929583128715-vha62ek3tmooka7n67dhff3r77na4e0l.apps.googleusercontent.com"
      }
    },
    "staging": {
      "name": "prepspaces-backend-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "GOOGLE_CLIENT_ID": "929583128715-vha62ek3tmooka7n67dhff3r77na4e0l.apps.googleusercontent.com"
      }
    }
  }
}
