{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prepspaces-backend",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "api.prepspaces.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "env": {
    "production": {
      "name": "prepspaces-backend-production",
      "routes": [
        {
          "pattern": "api.prepspaces.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "staging": {
      "name": "prepspaces-backend-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    }
  }
}
